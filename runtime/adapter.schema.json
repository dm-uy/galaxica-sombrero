{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter.schema.json",
  "title": "Adapter of a harness to the agent methodology",
  "description": "One JSON file in the harness's own repository. conform adapter validates it with its own standard-library code.",
  "x-rule": "adapter.schema",
  "type": "object",
  "required": ["harness", "owner", "spec_version", "spec_root", "parameters", "capabilities", "files"],
  "additionalProperties": false,
  "properties": {
    "harness": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "spec_version": {"x-rule": "adapter.spec-version", "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "spec_root": {"type": "string", "minLength": 1},
    "parameters": {"x-rule": "adapter.parameter", "type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "capabilities": {"x-rule": "adapter.capability", "type": "object", "additionalProperties": {"$ref": "#/$defs/capability"}},
    "files": {"x-rule": "adapter.file-coverage", "type": "object", "additionalProperties": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "capability": {
      "x-rule": "adapter.capability",
      "type": "object",
      "additionalProperties": false,
      "properties": {"mechanism": {"type": "string"}, "fallback": {"type": "string"}},
      "anyOf": [
        {"required": ["mechanism"], "properties": {"mechanism": {"minLength": 1}}},
        {"required": ["fallback"], "properties": {"fallback": {"minLength": 1}}}
      ]
    },
    "file": {
      "type": "object",
      "required": ["mode"],
      "properties": {"mode": {"enum": ["reference", "vendored", "not-applied"]}},
      "allOf": [
        {"if": {"required": ["mode"], "properties": {"mode": {"const": "reference"}}}, "then": {"$ref": "#/$defs/reference"}},
        {"if": {"required": ["mode"], "properties": {"mode": {"const": "vendored"}}}, "then": {"$ref": "#/$defs/vendored"}},
        {"if": {"required": ["mode"], "properties": {"mode": {"const": "not-applied"}}}, "then": {"$ref": "#/$defs/notApplied"}}
      ]
    },
    "reference": {
      "x-rule": "adapter.reference",
      "type": "object",
      "additionalProperties": false,
      "properties": {"mode": {"const": "reference"}, "via": {"type": "string", "minLength": 1}}
    },
    "vendored": {
      "x-rule": "adapter.vendored",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "path", "sha256"],
      "properties": {
        "mode": {"const": "vendored"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "overrides": {"type": "array", "items": {"$ref": "#/$defs/override"}}
      }
    },
    "override": {
      "x-rule": "adapter.override",
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "reason", "owner"],
      "properties": {
        "anchor": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "trigger": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["until"]}, {"required": ["trigger"]}]
    },
    "notApplied": {
      "x-rule": "adapter.not-applied",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {"mode": {"const": "not-applied"}, "reason": {"type": "string", "minLength": 1}}
    }
  }
}
